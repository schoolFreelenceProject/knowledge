APP_ENV=production
DATABASE_AUTO_CREATE=false

POSTGRES_DB=company_rag
POSTGRES_USER=rag
POSTGRES_PASSWORD=replace-with-a-long-random-password
DATABASE_URL=postgresql+psycopg://rag:replace-with-a-long-random-password@postgres:5432/company_rag

JWT_SECRET_KEY=replace-with-at-least-32-random-characters
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION_NAME=company_documents
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=gemma4:31b-cloud
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2

RETRIEVAL_MODE=vector
HYBRID_FUSION_STRATEGY=rrf
HYBRID_VECTOR_WEIGHT=0.6
HYBRID_BM25_WEIGHT=0.4
HYBRID_CANDIDATE_MULTIPLIER=4
BM25_K1=1.5
BM25_B=0.75

RERANKER_ENABLED=false
RERANKER_MODEL_NAME=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANKER_CANDIDATE_SIZE=20
RERANKER_BATCH_SIZE=16

DOCUMENT_CHUNK_SIZE=1000
DOCUMENT_CHUNK_OVERLAP=150

MAX_REQUEST_BODY_BYTES=26214400
MAX_UPLOAD_BYTES=26214400
SECURITY_HEADERS_ENABLED=true
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60
CODE_REPOSITORY_ALLOWED_HOSTS=github.com,gitlab.com,bitbucket.org
AUDIT_LOG_ENABLED=true
LOG_LEVEL=INFO

MCP_HOST=0.0.0.0
MCP_PORT=8001
MCP_PATH=/mcp
MCP_PUBLIC_URL=http://localhost:8001/mcp
MCP_SERVICE_ACCOUNT_EMAIL=mcp-service@example.com
MCP_SERVICE_TOKEN_SHA256=replace-with-sha256-hex-digest-of-mcp-service-token
